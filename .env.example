# Copy to .env and fill in only the credentials you actually use.
# Nothing here is required for `./canary demo` — the demo runs fully offline.

# Cortensor Portal (https://portal.cortensor.network)
CORTENSOR_API_KEY=

# Optional OpenAI-compatible baseline providers
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# API key used by the bundled mock server in agent mode (any non-empty value)
CANARY_MOCK_KEY=mock

# Optional: where the CLI looks for targets.json
# CANARY_TARGETS=config/targets.json
# CANARY_HOME=.
